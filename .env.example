# Server configuration (all optional — safe defaults apply)
# Copy to .env (gitignored) and adjust locally.
# Loaded automatically at startup via `node --env-file-if-exists=.env` (see package.json
# "start" script). Real environment variables take precedence over .env values.

# HTTP listen port (default 3000)
PORT=3000

# Optional bearer token protecting endpoints (empty = open)
TOKEN=

# OpenAI-compatible LLM chat completions endpoint (e.g. SiliconCloud)
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=
LLM_MODEL=THUDM/GLM-4-9B-0414

# LLM request timeout in milliseconds (default 60000)
LLM_TIMEOUT=60000

# ONNX 推理线程数（intraOpNumThreads）。2C 机器默认 1，留一核给 HTTP/LLM
ORT_THREADS=1

# Optional proxy prefix for fetching source images (e.g. a pximg reverse proxy)
IMAGE_PROXY=

# Cache directory for translated results (relative to the server root by
# default — absolute paths pass through)
CACHE_DIR=.cache/

# Max accepted image size — plain bytes or "20mb" style (default 20971520 / 20MB)
MAX_IMAGE_BYTES=20971520

# Optional font file path used by the typesetting stage (empty = bundled/system default)
FONT_PATH=
